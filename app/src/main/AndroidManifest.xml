<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Network permissions for OpenFoodFacts API -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Camera permissions for real-time barcode scanning -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.camera.autofocus" android:required="false" />

    <application
        android:name=".NutriGuardApp"
        android:allowBackup="true"
        android:icon="@drawable/ic_nutriguard_logo"
        android:label="@string/app_name"
        android:roundIcon="@drawable/ic_nutriguard_logo"
        android:supportsRtl="true"
        android:theme="@style/Theme.NutriGuard">

        <!-- Main Screen with BottomNavigation and Fragments -->
        <activity
            android:name=".ui.main.MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustPan">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Product Detail Screen -->
        <activity
            android:name=".ui.detail.ProductDetailActivity"
            android:exported="false"
            android:parentActivityName=".ui.main.MainActivity" />

        <!-- ZXing Camera Scan Activity with custom orientation handling -->
        <activity
            android:name="com.journeyapps.barcodescanner.CaptureActivity"
            android:screenOrientation="fullSensor"
            android:stateNotNeeded="true"
            android:theme="@style/zxing_CaptureTheme"
            android:windowSoftInputMode="stateAlwaysHidden" />

    </application>

</manifest>
