<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="5dp"
    app:cardBackgroundColor="@color/surface_light"
    app:cardCornerRadius="16dp"
    app:cardElevation="1dp"
    app:strokeColor="@color/card_stroke"
    app:strokeWidth="1dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="12dp">

        <!-- Product Image Thumbnail in Grab clean rounded container -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardThumbContainer"
            android:layout_width="74dp"
            android:layout_height="74dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/card_stroke"
            app:strokeWidth="1dp"
            app:cardBackgroundColor="#F8F9FA"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent">

            <ImageView
                android:id="@+id/imgProductThumb"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="fitCenter"
                android:padding="4dp"
                android:src="@drawable/ic_nutriguard_logo"
                android:contentDescription="@string/app_name" />

        </com.google.android.material.card.MaterialCardView>

        <!-- NutriScore Pill Badge (Top Right) -->
        <TextView
            android:id="@+id/badgeNutriScore"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="@drawable/bg_badge_nutriscore"
            android:gravity="center"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:textStyle="bold"
            tools:text="A"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Product Name -->
        <TextView
            android:id="@+id/txtProductName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="8dp"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="@color/text_primary"
            android:textSize="14sp"
            android:textStyle="bold"
            tools:text="Nutella Pâte à tartiner noisettes et cacao"
            app:layout_constraintStart_toEndOf="@id/cardThumbContainer"
            app:layout_constraintEnd_toStartOf="@id/badgeNutriScore"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Product Brand & Quantity -->
        <TextView
            android:id="@+id/txtProductBrand"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginTop="2dp"
            android:layout_marginEnd="8dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            tools:text="Ferrero • 400g"
            app:layout_constraintStart_toEndOf="@id/cardThumbContainer"
            app:layout_constraintEnd_toStartOf="@id/badgeNutriScore"
            app:layout_constraintTop_toBottomOf="@id/txtProductName" />

        <!-- Allergen Warning Tag if detected (Grab soft red alert style) -->
        <TextView
            android:id="@+id/txtAllergenAlert"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginTop="5dp"
            android:background="@drawable/bg_rounded_card"
            android:backgroundTint="@color/alert_danger_bg"
            android:paddingHorizontal="7dp"
            android:paddingVertical="2dp"
            android:textColor="@color/alert_danger_text"
            android:textSize="11sp"
            android:textStyle="bold"
            android:visibility="gone"
            tools:text="⚠️ Contient Lait"
            tools:visibility="visible"
            app:layout_constraintStart_toEndOf="@id/cardThumbContainer"
            app:layout_constraintTop_toBottomOf="@id/txtProductBrand" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</com.google.android.material.card.MaterialCardView>
